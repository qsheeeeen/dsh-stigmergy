{
  "name": "@local/dsh-stigmergy",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A shared trace field for a delegation tree: agents coordinate by leaving traces in a common environment instead of messaging each other.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "stigmergy",
    "subagent",
    "multi-agent"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
